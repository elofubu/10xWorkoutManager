@page "/plans/{planId:long}/days/{dayId:long}"
@using WorkoutManager.BusinessLogic.Commands
@using WorkoutManager.BusinessLogic.DTOs
@using WorkoutManager.Web.Components
@using WorkoutManager.Web.Services

<div class="plan-day-exercise-wrapper">

    <MudOverlay Visible="_isLoading" LightBackground="true">
        <MudProgressCircular Style="color: var(--color-secondary-text)" Indeterminate="true" />
    </MudOverlay>

    @if (!_isLoading)
    {
        <MudContainer Class="px-0 py-2 d-flex align-center gap-2 training-day-header">
            <MudIconButton Class="mr-2" Icon="@Icons.Material.Outlined.ArrowBack" aria-label="Back" OnClick="@(() => NavigationManager.NavigateTo($"/plans/{PlanId}"))" />
            <MudText Class="flex-grow-1" Typo="Typo.h6">@_trainingDay.Name</MudText>
        </MudContainer>
        <MudContainer Class="pa-0">
            @{
                var orderedExercises = _trainingDay.Exercises.OrderBy(e => e.Order).ToList();
            }
            @for (var i = 0; i < orderedExercises.Count; i++)
            {
                var index = i;
                var exercise = orderedExercises[index];
                <div class="training-day-item">
                    <div>@(index + 1)</div>
                    <div class="exercise-name">@exercise.Name</div>
                    <MudIconButton Icon="@Icons.Material.Outlined.ArrowUpward" aria-label="Move up" Size="Size.Small"
                                   OnClick="@(async () => await MoveExercise(orderedExercises, index, -1))"
                                   Disabled="@(_isBusy || index == 0)" />
                    <MudIconButton Icon="@Icons.Material.Outlined.ArrowDownward" aria-label="Move down" Size="Size.Small"
                                   OnClick="@(async () => await MoveExercise(orderedExercises, index, 1))"
                                   Disabled="@(_isBusy || index == orderedExercises.Count - 1)" />
                    <MudIconButton Icon="material-symbols-outlined/delete" aria-label="Remove exercise" Size="Size.Small"
                                   OnClick="@(async () => await RemoveExercise(exercise.PlanDayExerciseId))"
                                   Disabled="@(_isBusy || _deletingExerciseId == exercise.PlanDayExerciseId)" />
                </div>
            }

            @if (_trainingDay.Exercises == null || !_trainingDay.Exercises.Any())
            {
                <div class="no-data">
                    No exercises yet ;)
                </div>
            }
        </MudContainer>
        <MudButton Class="add-exercise-button" StartIcon="@Icons.Material.Outlined.Add" FullWidth=true OnClick="AddExercise">Add exercise</MudButton>
    }
</div>

@code {
    [Parameter]
    public long PlanId { get; set; }

    [Parameter]
    public long DayId { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    private IWorkoutPlanService WorkoutPlanService { get; set; } = default!;

    [Inject]
    private IDialogService DialogService { get; set; } = default!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = default!;

    private WorkoutPlanDetailDto? _plan;
    private TrainingDayDto _trainingDay = default!;

    private bool _isLoading = true;
    private long? _deletingExerciseId;
    private bool _isBusy;

    private async Task MoveExercise(List<PlanDayExerciseDto> ordered, int index, int direction)
    {
        var target = index + direction;
        if (_isBusy || target < 0 || target >= ordered.Count)
        {
            return;
        }

        // Swap the two neighbours, then renumber the whole list 1..n so orders stay unique
        // (removing exercises leaves gaps, and older data may contain duplicates).
        var reordered = ordered.ToList();
        (reordered[index], reordered[target]) = (reordered[target], reordered[index]);

        var commands = reordered
            .Select((e, i) => new ReorderExerciseCommand(e.PlanDayExerciseId, i + 1))
            .ToList();

        _isBusy = true;
        try
        {
            await WorkoutPlanService.ReorderExercisesAsync(PlanId, DayId, commands);
            await LoadPlan();
        }
        catch
        {
            Snackbar.Add("Failed to change the exercise order", Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RemoveExercise(long planDayExerciseId)
    {
        var parameters = new DialogParameters
        {
            { nameof(ConfirmationDialog.Title), "Remove Exercise" },
            { nameof(ConfirmationDialog.ContentText), "Are you sure you want to remove this exercise?" },
            { nameof(ConfirmationDialog.ConfirmButtonText), "Remove" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Remove Exercise", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        _deletingExerciseId = planDayExerciseId;
        try
        {
            await WorkoutPlanService.RemoveExerciseFromTrainingDayAsync(PlanId, DayId, planDayExerciseId);
            await LoadPlan();
            Snackbar.Add("Exercise removed successfully", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Failed to remove exercise", Severity.Error);
        }
        finally
        {
            _deletingExerciseId = null;
        }
    }


    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            await LoadPlan();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadPlan()
    {
        _plan = await WorkoutPlanService.GetWorkoutPlanByIdAsync(PlanId);
        _trainingDay = _plan.TrainingDays.FirstOrDefault(p => p.Id == DayId);
    }

    private async Task AddExercise()
    {
        var dialogOptions = new DialogOptions
        {
            FullWidth = true,
            CloseButton = true,
            NoHeader = true,
            FullScreen = true
        };

        var dialog = await DialogService.ShowAsync<ExercisePickerDialog>("Add Exercise", dialogOptions);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is ExerciseDto selectedExercise)
        {
            try
            {
                var trainingDay = _plan!.TrainingDays.First(td => td.Id == DayId);
                var nextOrder = trainingDay.Exercises.Any() ? trainingDay.Exercises.Max(e => e.Order) + 1 : 1;

                await WorkoutPlanService.AddExerciseToTrainingDayAsync(PlanId, DayId, new AddExerciseToTrainingDayCommand
                {
                    ExerciseId = (int)selectedExercise.Id,
                    Order = nextOrder
                });
                await LoadPlan();
                Snackbar.Add("Exercise added successfully", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
            finally
            {
                // _isAddingExercise = false;
            }
        }
    }


}

@page "/session/workout/{SessionId:long}"
@using WorkoutManager.BusinessLogic.DTOs


<MudOverlay Visible="_isLoading" LightBackground="true">
    <MudProgressCircular Style="color: var(--color-secondary-text)" Indeterminate="true" />
</MudOverlay>

@if (_session is not null)
{
    var count = _session.Exercises.Count;
    <div class="session-wrapper">
        <header class="session-progress">
            <div class="session-progress-title">
                <span class="session-step">@(_index + 1)<small>/@count</small></span>
                <span class="session-next">
                    @if (count > _index + 1)
                    {
                        @($"Next: {OrderedExercises[_index + 1].ExerciseName}")
                    }
                    else
                    {
                        @("Last exercise")
                    }
                </span>
                <MudButton Class="session-discard" Variant="Variant.Text" Size="Size.Small" Disabled="_isLoading" OnClick="CancelWorkout">Discard</MudButton>
            </div>
            <div class="session-segments" role="progressbar" aria-label="Workout progress"
                 aria-valuemin="1" aria-valuemax="@count" aria-valuenow="@(_index + 1)">
                @for (var i = 0; i < count; i++)
                {
                    <span class="@(i < _index ? "done" : i == _index ? "current" : "")"></span>
                }
            </div>
        </header>

        <ExerciseLogPanel Exercise="_currentExercise"
                          Previous="@_previousSessionData.GetValueOrDefault(_currentExercise!.ExerciseId)"
                          @bind-Weight="_weight"
                          @bind-Reps="_reps"
                          OnAddSet="@(() => AddSetAsync(_currentExercise!, _weight, _reps))"
                          OnRemoveSet="@((ExerciseSetDto set) => RemoveSetAsync(_currentExercise!, set))"
                          OnNotesChanged="@((string? notes) => SetNotesAsync(_currentExercise!, notes))" />

        @if (!_isLoading && _pinnedExercise is null && PinnableExercises.Any())
        {
            <div class="session-pin-bar">
                <MudMenu Label="Superset with…" StartIcon="@Icons.Material.Outlined.PushPin"
                         Variant="Variant.Text" Size="Size.Small" AnchorOrigin="Origin.TopLeft" TransformOrigin="Origin.BottomLeft">
                    @foreach (var candidate in PinnableExercises)
                    {
                        <MudMenuItem OnClick="@(() => PinExerciseAsync(candidate))">
                            @($"{OrderedExercises.IndexOf(candidate) + 1}. {candidate.ExerciseName}")@(candidate.Sets.Any(s => s.Reps != 0) ? $" ({candidate.Sets.Count(s => s.Reps != 0)} sets)" : "")
                        </MudMenuItem>
                    }
                </MudMenu>
            </div>
        }

        @if (_pinnedExercise is not null)
        {
            <ExerciseLogPanel Exercise="_pinnedExercise"
                              Pinned="true"
                              Previous="@_previousSessionData.GetValueOrDefault(_pinnedExercise.ExerciseId)"
                              @bind-Weight="_pinnedWeight"
                              @bind-Reps="_pinnedReps"
                              OnAddSet="@(() => AddSetAsync(_pinnedExercise!, _pinnedWeight, _pinnedReps))"
                              OnRemoveSet="@((ExerciseSetDto set) => RemoveSetAsync(_pinnedExercise!, set))"
                              OnNotesChanged="@((string? notes) => SetNotesAsync(_pinnedExercise!, notes))">
                <HeaderActions>
                    <MudIconButton Icon="@Icons.Material.Outlined.Close" aria-label="Unpin exercise" Disabled="_isLoading" OnClick="UnpinExerciseAsync" />
                </HeaderActions>
            </ExerciseLogPanel>
        }

        @* Docked where the bottom navigation normally is (it is hidden on this page). *@
        <div class="session-dock">
            <RestTimer @ref="_restTimer" />
            <nav class="session-navigation" aria-label="Exercise navigation">
                @if (_index > 0)
                {
                    <MudButton Class="session-back" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.ArrowBackIos" Disabled="_isLoading" OnClick="PreviousStep">Back</MudButton>
                }
                @if (count == _index + 1)
                {
                    <MudButton Class="session-forward session-complete" Variant="Variant.Filled" EndIcon="@Icons.Material.Outlined.Check" Disabled="_isLoading" OnClick="CompleteSession">Complete</MudButton>
                }
                else
                {
                    <MudButton Class="session-forward" Variant="Variant.Filled" EndIcon="@Icons.Material.Outlined.ArrowForwardIos" Disabled="_isLoading" OnClick="NextStep">Next</MudButton>
                }
            </nav>
        </div>
    </div>
}
